# =====================================================================
# Copia este archivo como  .env  y rellena la clave de servicio.
# NUNCA subas el .env a git — ya está en .gitignore.
# =====================================================================

# Este archivo SÍ está en el repositorio, así que no lleva valores reales.
# El repo es público: aunque la clave publicable esté pensada para serlo,
# publicarla deja que cualquiera consulte la base y consuma los 5 GB de
# egress del plan gratuito. Los valores viven en el .env local (ignorado
# por git) y, para la ejecución automática, en los secrets del repositorio.

# --- Supabase --------------------------------------------------------
SUPABASE_URL=https://TU_PROYECTO.supabase.co

# Clave PÚBLICA. Solo puede LEER (política RLS "lectura publica").
# Es la única que va en la app Dash.
SUPABASE_ANON_KEY=sb_publishable_...

# Clave de ADMINISTRADOR. Salta RLS: puede borrar la base entera.
# Solo la usan los scripts de ingesta, nunca el frontend.
# Dashboard > Project Settings > API Keys > service_role (hay que pulsar
# "Reveal" antes de copiar, o copias la máscara).
SUPABASE_SERVICE_KEY=pega_aqui_tu_service_role_key

# --- LLM -------------------------------------------------------------
# El modelo corre en lote nocturno, jamás en la ruta del usuario: con
# 8.000 tokens por minuto de capa gratuita, cualquier otra cosa agota la
# cuota en una tarde. Basta con una de las dos.
GROQ_API_KEY=
GEMINI_API_KEY=
